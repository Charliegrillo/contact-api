{
  "name": "contact-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "watch": "nodemon --watch src --ext ts --exec 'ts-node src/server.ts'",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.scripts.json",
    "generate:entity": "ts-node scripts/generate-entity.ts",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "postbuild": "echo 'Build completed successfully'",
    "migrate": "ts-node src/infrastructure/database/migrate.ts migrate",
    "migrate:up": "ts-node src/infrastructure/database/migrate.ts up",
    "migrate:down": "ts-node src/infrastructure/database/migrate.ts rollback",
    "migrate:rollback": "ts-node src/infrastructure/database/migrate.ts rollback",
    "migrate:status": "ts-node src/infrastructure/database/migrate.ts status",
    "migrate:reset": "ts-node src/infrastructure/database/migrate.ts reset",
    "db:init": "npm run migrate",
    "db:seed": "ts-node src/infrastructure/database/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@upstash/redis": "^1.38.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "nodemailer": "^9.1.0",
    "redis": "^6.2.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/node-cache": "^4.1.3",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
